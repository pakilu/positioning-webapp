@model IEnumerable<App.Domain.SessionConfig>

@{
    ViewData["Title"] = "Rooms";
}

<h1>Rooms</h1>
<p class="text-muted">
    Each room is a positioning layout: floor plan, anchors, and tags. Open a room to place anchors on its plan and start sessions on it.
</p>

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ Create room</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.PlannedDurationSeconds)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id"><strong>@item.Name</strong></a>
            </td>
            <td>@Html.DisplayFor(modelItem => item.Description)</td>
            <td>@Html.DisplayFor(modelItem => item.PlannedDurationSeconds)</td>
            <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Open</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
