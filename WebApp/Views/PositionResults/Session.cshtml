@model App.Domain.Session

@{
    ViewData["Title"] = $"Position results — {Model.Name}";
    var results = Model.PositionResults ?? new List<App.Domain.PositionResult>();
    var latest = results.OrderByDescending(r => r.RecordedAt).FirstOrDefault();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">@Model.Name</h1>
        <div class="text-muted">
            @Model.SessionConfig.Name |
            @Model.Status |
            Started @(Model.StartedAt?.ToLocalTime().ToString("g") ?? "not started")
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">All sessions</a>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>
</div>

<div class="mb-3">
    <span class="fw-semibold">@results.Count result@(results.Count == 1 ? "" : "s")</span>
    @if (latest is not null)
    {
        <span class="text-muted">
            &middot; Latest @latest.RecordedAt.ToLocalTime().ToString("g")
        </span>
    }
</div>

@if (!results.Any())
{
    <div class="alert alert-secondary">No position results have been saved for this session yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Recorded</th>
                    <th>Tag</th>
                    <th class="text-end">X</th>
                    <th class="text-end">Y</th>
                    <th class="text-end">Z</th>
                    <th class="text-end">Accuracy</th>
                    <th>Saved</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in results)
            {
                <tr>
                    <td>@item.RecordedAt.ToLocalTime().ToString("g")</td>
                    <td>@item.TagChip.DeviceIdentifier</td>
                    <td class="text-end">@item.XCoord</td>
                    <td class="text-end">@item.YCoord</td>
                    <td class="text-end">@(item.ZCoord?.ToString() ?? "-")</td>
                    <td class="text-end">@(item.Accuracy?.ToString() ?? "-")</td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-nowrap text-end">
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
