@model WebApp.Models.PositionResults.SessionPositionResultsViewModel

@{
    ViewData["Title"] = "Position results by session";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">@ViewData["Title"]</h1>
        <div class="text-muted">Select a session to view its computed position fixes.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>
</div>

@if (!Model.Sessions.Any())
{
    <div class="alert alert-info">
        No sessions were found.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var group in Model.Sessions)
        {
            var session = group.Session;
            <div class="col">
                <a asp-action="Session" asp-route-id="@session.Id"
                   class="card h-100 text-decoration-none text-reset session-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h2 class="h5 mb-1">@session.Name</h2>
                            <span class="badge bg-secondary">@session.Status</span>
                        </div>
                        <div class="text-muted small mb-2">
                            @session.SessionConfig.Name
                        </div>
                        <div class="small">
                            <div>
                                <strong>@group.ResultCount</strong> result@(group.ResultCount == 1 ? "" : "s")
                            </div>
                            <div class="text-muted">
                                Started @(session.StartedAt?.ToLocalTime().ToString("g") ?? "not started")
                            </div>
                            @if (group.LatestRecordedAt is not null)
                            {
                                <div class="text-muted">
                                    Latest @group.LatestRecordedAt.Value.ToLocalTime().ToString("g")
                                </div>
                            }
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
